<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HandloomFactory.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HandloomFactory.App.Views"
    xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
    Title="{x:Static s:AppResources.AppName}"
    FlyoutBehavior="Disabled">

    <!-- Start decides between "data can't be opened", first-launch setup and the PIN login. -->
    <ShellContent Route="start" ContentTemplate="{DataTemplate views:StartPage}" Shell.NavBarIsVisible="False" />
    <ShellContent Route="setup" ContentTemplate="{DataTemplate views:SetupPage}" Shell.NavBarIsVisible="False" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Title="{x:Static s:AppResources.Tab_Home}" Route="home" ContentTemplate="{DataTemplate views:HomePage}">
            <ShellContent.Icon><FontImageSource Glyph="🏠" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Entry}" Route="entry" ContentTemplate="{DataTemplate views:EntryPage}">
            <ShellContent.Icon><FontImageSource Glyph="✏" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Workers}" Route="workers" ContentTemplate="{DataTemplate views:WorkersPage}">
            <ShellContent.Icon><FontImageSource Glyph="👥" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Reports}" Route="reports" ContentTemplate="{DataTemplate views:ReportPage}">
            <ShellContent.Icon><FontImageSource Glyph="∑" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Settings}" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon><FontImageSource Glyph="⚙" Size="22" /></ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>

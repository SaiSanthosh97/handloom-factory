<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
             xmlns:vm="clr-namespace:HandloomFactory.App.ViewModels"
             x:Class="HandloomFactory.App.Views.AuditPage"
             x:DataType="vm:AuditViewModel"
             Title="{x:Static s:AppResources.Audit_Title}">
    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Items}" Margin="16,8">
            <CollectionView.EmptyView>
                <Label Text="{x:Static s:AppResources.Audit_Empty}" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditItem">
                    <VerticalStackLayout Padding="0,8" Spacing="2">
                        <Label Text="{Binding When}" Style="{StaticResource Subtle}" FontSize="13" />
                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="17" />
                        <Label Text="{Binding Details}" FontSize="15" IsVisible="{Binding HasDetails}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="1" Text="{x:Static s:AppResources.Audit_Export}" Style="{StaticResource OutlineButton}" Command="{Binding ExportCommand}" Margin="16,8,16,12"
                IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}" />
    </Grid>
</ContentPage>

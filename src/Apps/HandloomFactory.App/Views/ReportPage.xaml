<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
             xmlns:vm="clr-namespace:HandloomFactory.App.ViewModels"
             x:Class="HandloomFactory.App.Views.ReportPage"
             x:DataType="vm:ReportViewModel"
             Title="{x:Static s:AppResources.Tab_Reports}">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="16,8,16,4" Spacing="4">
            <!-- Week | Month | Year -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="{x:Static s:AppResources.Report_Week}" Style="{StaticResource OutlineButton}" Command="{Binding SetModeCommand}" CommandParameter="Week">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsWeek}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="{x:Static s:AppResources.Report_Month}" Style="{StaticResource OutlineButton}" Command="{Binding SetModeCommand}" CommandParameter="Month">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsMonth}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="{x:Static s:AppResources.Report_Year}" Style="{StaticResource OutlineButton}" Command="{Binding SetModeCommand}" CommandParameter="Year">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsYear}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- ◀ period ▶ -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" Style="{StaticResource StepButton}" Command="{Binding PreviousCommand}" />
                <Label Grid.Column="1" Text="{Binding PeriodText}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Grid.Column="2" Text="▶" Style="{StaticResource StepButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" />
            </Grid>
            <Label Text="{Binding SubText}" Style="{StaticResource Subtle}" HorizontalOptions="Center" IsVisible="{Binding IsWeek}" />
            <Button Text="{x:Static s:AppResources.Report_ThisWeek}" Style="{StaticResource LinkButton}" Command="{Binding CurrentCommand}" HorizontalOptions="Center" IsVisible="{Binding CanGoNext}" />

            <!-- Week: paid date used by "Mark paid" -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsWeek}">
                <Label Grid.Column="0" Text="{x:Static s:AppResources.Report_PaidDate}" VerticalOptions="Center" Style="{StaticResource Subtle}" />
                <DatePicker Grid.Column="1" Date="{Binding PaidDate}" MinimumDate="{Binding MinPaidDate}" MaximumDate="{Binding MaxPaidDate}" Format="ddd d MMM yyyy" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4" Spacing="8">
                <Label Text="{x:Static s:AppResources.Report_Empty}" IsVisible="{Binding IsEmpty}" Margin="0,24" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cards}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReportCard">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="20" />
                                        <Label Grid.Column="1" Text="{Binding Earnings}" FontFamily="OpenSansSemibold" FontSize="20" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Sarees}" />
                                        <Label Grid.Column="1" Text="{Binding Rate}" Style="{StaticResource Subtle}" />
                                    </Grid>
                                    <!-- Sun … Sat (week view only) -->
                                    <FlexLayout Direction="Row" JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Days}" IsVisible="{Binding HasDays}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DayCell">
                                                <VerticalStackLayout WidthRequest="40">
                                                    <Label Text="{Binding Weekday}" Style="{StaticResource Subtle}" FontSize="13" HorizontalOptions="Center" />
                                                    <Label Text="{Binding Count}" FontSize="18" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <!-- Payment (week view only) -->
                                    <Label Text="{Binding PaymentText}" FontFamily="OpenSansSemibold" IsVisible="{Binding HasPayment}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsPaid}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding PaymentNote}" Style="{StaticResource Subtle}" FontSize="14" IsVisible="{Binding HasPaymentNote}" />
                                    <Button Text="{x:Static s:AppResources.Report_MarkPaid}" IsVisible="{Binding CanMarkPaid}"
                                            Command="{Binding MarkPaidCommand, Source={RelativeSource AncestorType={x:Type vm:ReportViewModel}}, x:DataType=vm:ReportViewModel}" CommandParameter="{Binding .}" />
                                    <Button Text="{x:Static s:AppResources.Report_Undo}" Style="{StaticResource LinkButton}" HorizontalOptions="End" IsVisible="{Binding CanUndo}"
                                            Command="{Binding UndoPaidCommand, Source={RelativeSource AncestorType={x:Type vm:ReportViewModel}}, x:DataType=vm:ReportViewModel}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,12" Spacing="6">
            <Label Text="{Binding TotalsText}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
            <Label Text="{Binding PaymentTotalsText}" Style="{StaticResource Subtle}" HorizontalOptions="Center" IsVisible="{Binding IsWeek}" />
            <Button Text="{x:Static s:AppResources.Report_MarkAllPaid}" Style="{StaticResource OutlineButton}" Command="{Binding MarkAllPaidCommand}" IsVisible="{Binding CanMarkAll}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

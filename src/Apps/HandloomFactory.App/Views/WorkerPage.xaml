<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
             xmlns:vm="clr-namespace:HandloomFactory.App.ViewModels"
             x:Class="HandloomFactory.App.Views.WorkerPage"
             x:DataType="vm:WorkerViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <!-- Existing worker: code and figures -->
            <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding IsNew, Converter={StaticResource Not}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding CodeText}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding TodayText}" />
                    <Label Text="{Binding WeekText}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding MonthText}" />
                    <Label Text="{x:Static s:AppResources.Worker_DisabledNote}" TextColor="{StaticResource Warning}" IsVisible="{Binding IsActive, Converter={StaticResource Not}}" />
                </VerticalStackLayout>
            </Border>

            <!-- The worker's own phone (0.3.0) -->
            <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding IsActive}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsNew}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <!-- The owner who weaves uses this phone: no phone to link. -->
                    <DataTrigger TargetType="Border" Binding="{Binding IsOwnerRecord}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static s:AppResources.Worker_Phone_Title}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding PhoneText}" FontFamily="OpenSansSemibold" />
                    <Button Text="{x:Static s:AppResources.Worker_LinkPhone}" Style="{StaticResource OutlineButton}" Command="{Binding LinkPhoneCommand}" />
                    <Button Text="{x:Static s:AppResources.Worker_Unlink}" Style="{StaticResource LinkButton}" Command="{Binding UnlinkPhoneCommand}" IsVisible="{Binding IsPhoneLinked}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static s:AppResources.Worker_Name}" Style="{StaticResource SectionLabel}" />
            <Entry Text="{Binding Name}" MaxLength="80" Keyboard="Text" />
            <Label Text="{x:Static s:AppResources.Worker_Phone}" Style="{StaticResource SectionLabel}" />
            <Entry Text="{Binding Phone}" MaxLength="16" Keyboard="Telephone" />

            <!-- New worker: first rate -->
            <VerticalStackLayout IsVisible="{Binding IsNew}" Spacing="8">
                <Label Text="{x:Static s:AppResources.Worker_Rate}" Style="{StaticResource SectionLabel}" />
                <Entry Text="{Binding RateText}" Keyboard="Numeric" MaxLength="9" Placeholder="500" />
                <Label Text="{x:Static s:AppResources.Worker_RateFrom}" Style="{StaticResource SectionLabel}" />
                <DatePicker Date="{Binding RateFrom}" Format="ddd d MMM yyyy" />
                <Label Text="{x:Static s:AppResources.Worker_RateFromHint}" Style="{StaticResource Subtle}" FontSize="14" />
            </VerticalStackLayout>

            <Button Text="{x:Static s:AppResources.Common_Save}" Command="{Binding SaveCommand}" Margin="0,12,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />

            <!-- Existing worker: rate history and change -->
            <VerticalStackLayout IsVisible="{Binding IsNew, Converter={StaticResource Not}}" Spacing="8">
                <Label Text="{x:Static s:AppResources.Worker_RateHistory}" Style="{StaticResource SectionLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RateHistory}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{x:Static s:AppResources.Worker_History}" Style="{StaticResource SectionLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontSize="16" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static s:AppResources.Worker_ChangeRate}" Style="{StaticResource Heading}" FontSize="20" />
                        <Label Text="{x:Static s:AppResources.Worker_NewRate}" Style="{StaticResource Subtle}" />
                        <Entry Text="{Binding NewRateText}" Keyboard="Numeric" MaxLength="9" />
                        <Label Text="{x:Static s:AppResources.Worker_NewRateFrom}" Style="{StaticResource Subtle}" />
                        <DatePicker Date="{Binding NewRateFrom}" Format="ddd d MMM yyyy" />
                        <Button Text="{x:Static s:AppResources.Worker_ChangeRate}" Style="{StaticResource OutlineButton}" Command="{Binding ChangeRateCommand}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsOwnerRecord, Converter={StaticResource Not}}">
                    <Button Text="{x:Static s:AppResources.Worker_Disable}" Style="{StaticResource DangerButton}" Command="{Binding ToggleActiveCommand}"
                            IsVisible="{Binding IsActive}" Margin="0,16,0,24" />
                    <Button Text="{x:Static s:AppResources.Worker_Enable}" Style="{StaticResource OutlineButton}" Command="{Binding ToggleActiveCommand}"
                            IsVisible="{Binding IsActive, Converter={StaticResource Not}}" Margin="0,16,0,24" />
                </VerticalStackLayout>
                <Label Text="{x:Static s:AppResources.Worker_OwnerNote}" Style="{StaticResource Subtle}" FontSize="14" Margin="0,16,0,24"
                       IsVisible="{Binding IsOwnerRecord}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

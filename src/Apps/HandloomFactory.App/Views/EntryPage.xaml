<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
             xmlns:vm="clr-namespace:HandloomFactory.App.ViewModels"
             x:Class="HandloomFactory.App.Views.EntryPage"
             x:DataType="vm:EntryViewModel"
             Title="{x:Static s:AppResources.Entry_Title}">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Day: ◀ date ▶ (no future days) -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,4" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="◀" Style="{StaticResource StepButton}" Command="{Binding PreviousCommand}" />
                <DatePicker Grid.Column="1" Date="{Binding Date}" MaximumDate="{Binding MaxDate}" Format="ddd d MMM yyyy" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="▶" Style="{StaticResource StepButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" />
            </Grid>
            <Label Text="{Binding DateTitle}" Style="{StaticResource Heading}" HorizontalOptions="Center" />
            <Button Text="{x:Static s:AppResources.Entry_Today}" Style="{StaticResource LinkButton}" Command="{Binding TodayCommand}" HorizontalOptions="Center" IsVisible="{Binding CanGoNext}" />
            <Label Text="{x:Static s:AppResources.Entry_Hint}" Style="{StaticResource Subtle}" FontSize="14" IsVisible="{Binding HasRows}" />
        </VerticalStackLayout>

        <!-- One row per worker: name, rate, big number box -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4" Spacing="8">
                <Label Text="{x:Static s:AppResources.Entry_NoWorkers}" IsVisible="{Binding HasRows, Converter={StaticResource Not}}" Margin="0,24" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryRow">
                            <Border Style="{StaticResource Card}" Padding="12,8">
                                <Grid ColumnDefinitions="*,110" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="20" />
                                        <Label Text="{Binding Note}" Style="{StaticResource Subtle}" FontSize="14" />
                                    </VerticalStackLayout>
                                    <Entry Grid.Column="1" Text="{Binding Text}" Keyboard="Numeric" MaxLength="3" FontSize="30"
                                           HorizontalTextAlignment="Center" IsEnabled="{Binding HasRate}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Total + Save always visible -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="16,8,16,12" ColumnSpacing="12" IsVisible="{Binding HasRows}">
            <Label Grid.Column="0" Text="{Binding TotalText}" VerticalOptions="Center" FontFamily="OpenSansSemibold" />
            <Button Grid.Column="1" Text="{x:Static s:AppResources.Common_Save}" Command="{Binding SaveCommand}" WidthRequest="160"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
        </Grid>
    </Grid>
</ContentPage>

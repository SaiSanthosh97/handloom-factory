<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
             xmlns:vm="clr-namespace:HandloomFactory.App.ViewModels"
             x:Class="HandloomFactory.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static s:AppResources.Settings_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static s:AppResources.Settings_Factory}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding FactoryText}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding UserText}" Style="{StaticResource Subtle}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{x:Static s:AppResources.Settings_ChangePin}" Style="{StaticResource OutlineButton}" Command="{Binding ChangePinCommand}" />
            <Button Text="{x:Static s:AppResources.Settings_CheckUpdates}" Style="{StaticResource OutlineButton}" Command="{Binding CheckUpdatesCommand}" />
            <Button Text="{x:Static s:AppResources.Settings_Logout}" Style="{StaticResource OutlineButton}" Command="{Binding LogoutCommand}" />

            <Label Text="{Binding VersionText}" Style="{StaticResource Subtle}" HorizontalOptions="Center" Margin="0,24,0,0" />
            <Label Text="{x:Static s:AppResources.Settings_About}" Style="{StaticResource Subtle}" FontSize="14" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

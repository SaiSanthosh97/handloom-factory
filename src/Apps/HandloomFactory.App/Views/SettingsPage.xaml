<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:HandloomFactory.App.Resources.Strings"
             xmlns:vm="clr-namespace:HandloomFactory.App.ViewModels"
             x:Class="HandloomFactory.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static s:AppResources.Settings_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static s:AppResources.Settings_Factory}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding FactoryText}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding UserText}" Style="{StaticResource Subtle}" />
                    <Button Text="{x:Static s:AppResources.Settings_EditFactory}" Style="{StaticResource LinkButton}" Command="{Binding EditFactoryCommand}"
                            HorizontalOptions="Start" IsVisible="{Binding IsOwner}" />
                </VerticalStackLayout>
            </Border>

            <!-- Owner: also weaves (0.6.0) -->
            <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding IsOwner}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static s:AppResources.Settings_Weaves}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding OwnerWeaves}" />
                    </Grid>
                    <Label Text="{x:Static s:AppResources.Settings_WeavesExplain}" Style="{StaticResource Subtle}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsOwner}">
            <Label Text="{x:Static s:AppResources.Settings_Data}" Style="{StaticResource SectionLabel}" />
            <Button Text="{x:Static s:AppResources.Settings_Export}" Command="{Binding ExportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            <Label Text="{x:Static s:AppResources.Settings_ExportNote}" Style="{StaticResource Subtle}" FontSize="14" />
            <Button Text="{x:Static s:AppResources.Settings_Import}" Style="{StaticResource OutlineButton}" Command="{Binding ImportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            <Button Text="{x:Static s:AppResources.Audit_Title}" Style="{StaticResource OutlineButton}" Command="{Binding OpenHistoryCommand}" />
            </VerticalStackLayout>

            <!-- Owner: push notifications through the ntfy app (0.5.0) -->
            <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding IsOwner}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static s:AppResources.Notify_Title}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NotificationsOn}" />
                    </Grid>
                    <Label Text="{x:Static s:AppResources.Notify_Explain}" Style="{StaticResource Subtle}" FontSize="14" />
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding NotificationsOn}">
                        <Label Text="{Binding NotifyTopic}" FontSize="14" />
                        <Button Text="{x:Static s:AppResources.Notify_Open}" Style="{StaticResource OutlineButton}" Command="{Binding OpenNtfyCommand}" />
                        <Button Text="{x:Static s:AppResources.Notify_Test}" Style="{StaticResource LinkButton}" Command="{Binding TestNotificationCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static s:AppResources.Settings_Title}" Style="{StaticResource SectionLabel}" />
            <Button Text="{x:Static s:AppResources.Settings_ChangePin}" Style="{StaticResource OutlineButton}" Command="{Binding ChangePinCommand}" />
            <Button Text="{x:Static s:AppResources.Settings_CheckUpdates}" Style="{StaticResource OutlineButton}" Command="{Binding CheckUpdatesCommand}" />
            <Button Text="{x:Static s:AppResources.Settings_Logout}" Style="{StaticResource OutlineButton}" Command="{Binding LogoutCommand}" />
            <Button Text="{x:Static s:AppResources.Settings_StartOver}" Style="{StaticResource DangerButton}" Command="{Binding StartOverCommand}" Margin="0,16,0,0" />
            <Label Text="{x:Static s:AppResources.Settings_StartOverNote}" Style="{StaticResource Subtle}" FontSize="14" />

            <Label Text="{Binding VersionText}" Style="{StaticResource Subtle}" HorizontalOptions="Center" Margin="0,24,0,0" />
            <Label Text="{x:Static s:AppResources.Settings_About}" Style="{StaticResource Subtle}" FontSize="14" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
